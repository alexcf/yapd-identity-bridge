MIKROTIK_BASE_URL=https://router.home.arpa/rest
MIKROTIK_USERNAME=yapd-readonly
MIKROTIK_PASSWORD_FILE=/run/secrets/router-password
MIKROTIK_CA_FILE=/run/secrets/router-ca.pem
YAPD_BASE_URL=https://dns.home.arpa
YAPD_PASSWORD_FILE=/run/secrets/yapd-password
LOCAL_DNS_SUFFIX=home.arpa
DNS_SELF_ADDRESSES=192.168.50.2,192.168.50.3,192.168.50.53,10.53.53.53
SYNC_INTERVAL_SECONDS=300
IDENTITY_DATA=/var/lib/yapd-identity
FORWARD_REVERSE_CIDRS={}

# Optional multi-source configuration, mounted read-only into the worker.
# Without this, IDENTITY_PROVIDER=mikrotik remains the default.
# IDENTITY_PROVIDERS_FILE=/run/secrets/providers.json
